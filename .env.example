# Postgres (ex.: Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=3333
HOST=0.0.0.0

# IPs autorizados a criar posts (separados por vírgula). Aceita IPv4 e IPv6.
ALLOWED_IPS="127.0.0.1,::1"

# Use "true" SOMENTE se o servidor estiver atrás de proxy/CDN confiável
# (Vercel, Cloudflare, nginx...). Aí o IP real vem de X-Forwarded-For.
TRUST_PROXY=false

# Origens permitidas no CORS (separadas por vírgula). Use * para liberar tudo.
CORS_ORIGINS="http://localhost:5173"
